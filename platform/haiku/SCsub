#!/usr/bin/env python

Import("env")

sources = [
    "godot_haiku.cpp",
    "libgodot_haiku.cpp",
    "os_haiku.cpp",
    "display_server_haiku.cpp",
    "haiku_window.cpp",
    "haiku_gl_view.cpp",
    "gl_manager_haiku.cpp",
    "audio_driver_haiku.cpp",
    "crash_handler_haiku.cpp",
]

objects = []
for source in sources:
    objects.append(env.Object("#platform/haiku/" + source))

if env["library_type"] == "static":
    env.add_library("#bin/libgodot", objects)
elif env["library_type"] == "shared":
    env.add_shared_library("#bin/libgodot", objects)
else:
    env.add_program("#bin/godot", objects)
